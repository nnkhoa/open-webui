# Open WebUI (local ./start.sh) example env

# Server
PORT=8080
HOST=0.0.0.0

# If you use Postgres (optional)
# DATABASE_URL=postgresql://aibi:aibi_dev_2026@127.0.0.1:5432/aibi_demo

# Point Open WebUI's OpenAI-compatible provider to LiteLLM
OPENAI_API_BASE_URL=http://127.0.0.1:4000/v1

# Use LiteLLM Virtual Key (recommended) or MASTER KEY (admin)
# OPENAI_API_KEY=sk-...

# Disable Ollama if you don't use it
ENABLE_OLLAMA_API=false
ENABLE_OPENAI_API=true

